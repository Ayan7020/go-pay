SERVICE ?= wallet
DB_URL  ?= postgres://go-pay:go-pay-password@localhost:5433/$(SERVICE)?sslmode=disable
MIGRATE := migrate -path db/$(SERVICE)/migrations -database "$(DB_URL)"

.PHONY: migrate-up migrate-down migrate-version migrate-new migrate-force


migrate-up:
	@$(MIGRATE) up

migrate-down:
	@$(MIGRATE) down 1

migrate-version:
	@$(MIGRATE) version

migrate-new:
ifndef name
	$(error usage: make migrate-new name=add_something)
endif
	migrate create -ext sql -dir db/$(SERVICE)/migrations -seq $(name)

migrate-force:
ifndef version
	$(error usage: make migrate-force version=1)
endif
	@$(MIGRATE) force -- $(version)

.PHONY: generate test

generate:
	@sqlc generate

WALLET_TEST_DATABASE_URL ?= postgres://go-pay:go-pay-password@localhost:5433/wallet?sslmode=disable
export WALLET_TEST_DATABASE_URL
test:
	@go test -count=1 $(TESTFLAGS)  ./...